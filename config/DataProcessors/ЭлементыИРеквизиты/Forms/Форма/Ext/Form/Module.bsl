&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Товар");
	ТЗ.Колонки.Добавить("Цена");
	ТЗ.Колонки.Добавить("Ед");
	ТЗ.Колонки.Добавить("Количество");
	
	РНД = Новый ГенераторСлучайныхЧисел(2000);	
	
	Номенклатура = Справочники.Номенклатура.Выбрать();
	Пока Номенклатура.Следующий() Цикл
		Если Не Номенклатура.ЭтоГруппа Тогда 
			Стр = ТЗ.Добавить();
			
			Элем = Номенклатура.Ссылка;
			Стр.Товар = Элем;
			
			РНД_Количество = РНД.СлучайноеЧисло(2, 10);
			Стр.Количество = РНД_Количество;                       
			
			РНД_Цена = РНД.СлучайноеЧисло(2100, 4000);
			Стр.Цена = РНД_Цена;     
			
			Стр.Ед = Номенклатура.ЕдиницаИзмерения;  
			
		КонецЕсли;
	КонецЦикла;
	
	Объект.ТЧ.Очистить();
	
	Для каждого СтрокаТЗ из ТЗ Цикл
		
		СтрокаТаблицыПриемника = Объект.ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыПриемника, СтрокаТЗ);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры
