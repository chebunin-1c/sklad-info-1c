
&НаКлиенте
Процедура Старт(Команда)
	
	Поле3 = Поле1 + Поле2 + Объект.Поле4;
	Если Поле3 < 15 Тогда
		Элементы.Поле4.Видимость = Ложь;
	Иначе 
		Элементы.Поле4.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключательПриИзменении(Элемент)
	
	Если Объект.Переключатель = 1 Тогда
		Поле1 = 10;
	ИначеЕсли Объект.Переключатель = 2 Тогда
		Поле2 = 20;
	ИначеЕсли Объект.Переключатель = 3 Тогда
		Поле3 = 0;		
	КонецЕсли;
	
КонецПроцедуры

