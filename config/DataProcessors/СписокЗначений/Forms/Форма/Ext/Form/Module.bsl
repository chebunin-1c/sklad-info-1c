
&НаСервере
Процедура СтартНаСервере()    
	
	СЗ = Новый СписокЗначений;
	СЗ.Добавить(5000, "Стоимость офиса А");
	СЗ.Добавить("4000", "Стоимость офиса Б");
	
	СЗ.Сдвинуть(0, 1);
	
	СЗКопия = СЗ.Копировать();
	
	Для каждого значение из СЗ Цикл
		СЗ_Поиск = СЗ.НайтиПоЗначению(5000);
		Сообщить(СЗ_Поиск);
		
		Сообщить(значение.Значение);
		Сообщить(значение.Представление);
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура Старт(Команда)
	СтартНаСервере();
КонецПроцедуры
