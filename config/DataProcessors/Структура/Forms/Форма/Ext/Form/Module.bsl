
&НаСервере
Процедура СтартНаСервере()
	
	СТР = Новый Структура;
	СТР.Вставить("Магазин", "Эльдорадо");
	СТР.Вставить("Гарантия", Дата("20230101"));
	СТР.Вставить("Продавец", "Иванов ИИ");
	
	ЗначЭлемента = Неопределено;
	СТР.Свойство("Гарантия", ЗначЭлемента);
	Сообщить(ЗначЭлемента);
	
	Для каждого эл из СТР Цикл
		Сообщить(эл.Ключ);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Старт(Команда)
	СтартНаСервере();
КонецПроцедуры
